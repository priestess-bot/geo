ARG KNOWLEDGE_HEAVY_BASE=geno-knowledge-heavy:local
FROM ${KNOWLEDGE_HEAVY_BASE}

WORKDIR /app

COPY packages/geno_core ./packages/geno_core
COPY apps/api ./apps/api
COPY workers ./workers
COPY scripts/run_knowledge_component.py ./scripts/run_knowledge_component.py
COPY scripts/run_knowledge_heavy_components_smoke.py ./scripts/run_knowledge_heavy_components_smoke.py

ENV PYTHONPATH=/app:/app/packages/geno_core:/app/apps/api \
    GEO_KNOWLEDGE_COMPONENT_RUNNER=/app/scripts/run_knowledge_component.py

CMD ["python", "workers/knowledge_worker/run_knowledge_pipeline.py", "--loop-once"]
