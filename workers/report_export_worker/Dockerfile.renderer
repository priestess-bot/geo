FROM mcr.microsoft.com/playwright/python:v1.53.0-noble

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt ./api-requirements.txt

RUN pip install --no-cache-dir -r api-requirements.txt \
    bleach==6.2.0 \
    markdown==3.8.2 \
    playwright==1.53.0

COPY packages/geo_core ./packages/geo_core
COPY workers ./workers

ENV PYTHONPATH=/app:/app/packages/geo_core

CMD ["uvicorn", "workers.report_export_worker.pdf_renderer_api:app", "--host", "0.0.0.0", "--port", "8200"]
