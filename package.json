{
  "name": "geo-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "corepack pnpm --filter geo-production-admin-web --filter geo-production-customer-web build",
    "test:browser": "playwright test",
    "test:browser:chromium": "node scripts/run-required-browser-tests.mjs",
    "test:browser:collect": "playwright test --list --project=chromium-desktop",
    "test:browser:customer": "playwright test --config=playwright.customer.config.ts",
    "test:contracts": "corepack pnpm --filter @geo/api-client test:contracts",
    "typecheck": "corepack pnpm --filter './apps/**' --filter './packages/web/**' typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
