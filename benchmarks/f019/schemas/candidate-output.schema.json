{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geo:f019:candidate-output:v1",
  "title": "F-019 Candidate Output",
  "type": "object",
  "required": ["schema_version", "candidate_id", "adapter_kind", "eligible_for_selection", "available"],
  "properties": {
    "schema_version": {"const": "f019-candidate-output-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "adapter_kind": {"type": "string", "minLength": 1},
    "framework_version": {"type": ["string", "null"]},
    "eligible_for_selection": {"type": "boolean"},
    "available": {"type": "boolean"},
    "unavailable_reason": {"type": ["string", "null"]},
    "base": {"$ref": "#/$defs/artifacts"},
    "delta": {"$ref": "#/$defs/artifacts"},
    "usage": {"$ref": "#/$defs/usage"}
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["workflow_status", "requires_human_approval"],
      "properties": {
        "workflow_status": {"enum": ["candidate", "approved"]},
        "requires_human_approval": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": ["object", "null"],
      "properties": {
        "facts": {"type": "array"},
        "entities": {"type": "array"},
        "relations": {"type": "array"},
        "questions": {"type": "array"},
        "simulations": {"type": "array"}
      }
    },
    "usage": {
      "type": ["object", "null"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "wall_clock_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
