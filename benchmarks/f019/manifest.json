  "project_boundary": {
    "partition_key": "project_id",
    "project_ids": ["project-aurora", "project-boreal"],
    "rule": "所有候选、来源文档、支持事实和增量操作必须保持同一 project_id；任何越界计为硬门槛失败。"
  },
  "coverage": {
    "document_count": 20,
    "source_formats": ["html", "pdf", "docx", "text"],
    "content_categories": ["product", "competitor", "market"],
    "phenomena": ["facts", "entities", "relations", "conflicts", "time", "noise", "cross_project_isolation"],
    "normalized_text_note": "PDF 和 DOCX 以人工核对后的规范化文本进入 RAG 选型；文件解析器不在此 Gate 范围。"
  },
  "quality_gate": {
    "entity_precision_min": 0.85,
    "relation_precision_min": 0.8,
    "formal_fact_source_traceability": 1.0,
    "unsupported_question_rate_max": 0.05,
    "semantic_duplicate_question_rate_max": 0.1,
    "evidence_backed_dimension_coverage_min": 0.9,
    "project_leakage_count_max": 0,
    "approval_bypass_count_max": 0,
    "test_only_publication_count_max": 0,
    "incremental_duplicate_count_max": 0,
    "incremental_orphan_count_max": 0,
    "incremental_regression_count_max": 0,
    "diagnostic_only": ["fact_precision", "fact_recall", "entity_recall", "entity_f1", "relation_recall", "relation_f1"]
  },
  "quality_formula": {
    "entity_precision": 0.25,
    "relation_precision": 0.25,
    "question_groundedness": 0.2,
    "question_coverage": 0.2,
    "question_uniqueness": 0.1
  },
  "selection_policy": {
    "order": ["all_hard_gates", "quality_score", "estimated_cost_usd", "wall_clock_ms", "llamaindex_tiebreak"],
    "quality_close_threshold": 0.02,
    "quality_close_comparison": "strictly_less_than",
    "cost_time_policy": "record_only_no_hard_cap",
    "llamaindex_is_default_not_guaranteed_winner": true,
    "graphrag_production_eligible": false
  },
  "usage_fields": ["input_tokens", "output_tokens", "model_calls", "estimated_cost_usd", "wall_clock_ms"]
}
