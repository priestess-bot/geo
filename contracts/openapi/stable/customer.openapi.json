{
  "components": {
    "schemas": {
      "AuthIdentity": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "project_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Project Ids",
            "type": "array"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "tenant_id",
          "project_ids",
          "roles"
        ],
        "title": "AuthIdentity",
        "type": "object"
      },
      "CustomerProjectSummary": {
        "additionalProperties": false,
        "description": "Customer-safe project projection without internal membership metadata.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "market_code": {
            "title": "Market Code",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "display_name",
          "market_code",
          "status"
        ],
        "title": "CustomerProjectSummary",
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "surface": {
            "enum": [
              "internal",
              "customer"
            ],
            "title": "Surface",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "surface"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "JobState": {
        "enum": [
          "queued",
          "running",
          "finalizing",
          "retry_wait",
          "succeeded",
          "failed",
          "dead_lettered",
