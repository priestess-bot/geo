# 原始网页快照属于可审计证据，保持抓取时的原始字节，禁止换行符转换
docs/research_sources/**/raw_pages/*.html -text

# PDF 等二进制证据按二进制处理
*.pdf binary

# 作者撰写的文本统一使用 LF
*.md text eol=lf
*.txt text eol=lf

# Unified diff context lines carry a required leading marker; validate the
# applied source with git apply --check instead of treating the patch as source.
infra/dify/patches/*.patch -whitespace

# Applied migration bytes are checksum-ledger evidence, including their final blank line.
infra/db/alembic/sql/0093_dify_workflow_runtime.sql whitespace=-blank-at-eof
infra/db/alembic/sql/0094_dify_published_snapshot.sql whitespace=-blank-at-eof
infra/db/alembic/sql/0094_dify_published_snapshot.down.sql whitespace=-blank-at-eof
