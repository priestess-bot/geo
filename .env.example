# Stable local development configuration. Provider keys belong in mode 0600 files.
GEO_INTERNAL_API_HOST_PORT=8000
GEO_CUSTOMER_API_HOST_PORT=8001
GEO_ADMIN_WEB_HOST_PORT=3001
GEO_CUSTOMER_WEB_HOST_PORT=3000
GEO_POSTGRES_HOST_PORT=5432
GEO_MINIO_HOST_PORT=9000
GEO_MINIO_CONSOLE_HOST_PORT=9001
GEO_VALKEY_HOST_PORT=6379

GEO_AUTH_MODE=development
GEO_DEV_TOOLS_ENABLED=0
GEO_DEEPSEEK_API_KEY_FILE=./deepseek_api_key.txt
GEO_SERPAPI_KEY_FILE=./serpapi_key.txt
GEO_OPENROUTER_API_KEY_FILE=./openrouter_key.txt
GEO_OPENROUTER_MODEL=openai/gpt-5.5
GEO_OPENROUTER_HTTP_REFERER=https://geo.local
GEO_OPENROUTER_APP_TITLE=GEO Search Demo
GEO_PERPLEXITY_MODEL=perplexity/sonar
