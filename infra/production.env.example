# Every image value must include an immutable @sha256 digest before deployment.
GEO_POSTGRES_IMAGE=pgvector/pgvector:pg16@sha256:replace
GEO_MINIO_IMAGE=minio/minio:RELEASE.2025-01-20T14-49-07Z@sha256:replace
GEO_MINIO_MC_IMAGE=minio/mc:RELEASE.2025-02-21T16-00-46Z@sha256:replace
GEO_VALKEY_IMAGE=valkey/valkey:8.0.2-alpine@sha256:replace
GEO_API_IMAGE=registry.example.com/geo/api:release@sha256:replace
GEO_ADMIN_WEB_IMAGE=registry.example.com/geo/admin-web:release@sha256:replace
GEO_CUSTOMER_WEB_IMAGE=registry.example.com/geo/customer-web:release@sha256:replace
GEO_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.116.1@sha256:replace
GEO_STYLE_BROWSER_IMAGE=registry.example.com/geo/style-browser:release@sha256:replace
GEO_CONNECTOR_WORKER_IMAGE=registry.example.com/geo/connector-worker:release@sha256:replace
GEO_BROWSER_CAPTURE_WORKER_IMAGE=registry.example.com/geo/browser-capture-worker:release@sha256:replace

# Dify remains a separately version-pinned runtime on the shared private network.
GEO_DIFY_BIND_HOST=127.0.0.1
GEO_DIFY_HOST_PORT=15000
GEO_DIFY_CONSOLE_URL=https://dify.example.com
GEO_DIFY_STATE_HOST_FILE=/run/geo-secrets/geo-dify-state.json

# Release identity and runtime truth thresholds. Keep these values aligned with the runbook.
GEO_RELEASE_VERSION=replace-with-release-version
GEO_RELEASE_COMMIT=replace-with-full-lowercase-40-character-git-sha
GEO_READINESS_DEPENDENCY_TIMEOUT_SECONDS=2
GEO_READINESS_TOTAL_TIMEOUT_SECONDS=5
GEO_RUNTIME_HEARTBEAT_INTERVAL_SECONDS=10
GEO_RUNTIME_HEARTBEAT_STALE_SECONDS=30
GEO_RUNTIME_QUEUED_STALE_SECONDS=600
GEO_RUNTIME_OUTBOX_STALE_SECONDS=300
GEO_RUNTIME_RUNNING_GRACE_SECONDS=60
GEO_RUNTIME_FAILURE_WINDOW_SECONDS=86400
GEO_RUNTIME_EXPECTED_TASK_WORKER_INSTANCES=4
GEO_RUNTIME_EXPECTED_OUTBOX_RELAY_INSTANCES=1
GEO_RUNTIME_EXPECTED_STYLE_BROWSER_WORKER_INSTANCES=1
GEO_RUNTIME_EXPECTED_SYNTHETIC_ARTIFACT_MAINTENANCE_WORKER_INSTANCES=1
GEO_RUNTIME_EXPECTED_WORKFLOW_C_MAINTENANCE_WORKER_INSTANCES=1
GEO_RUNTIME_EXPECTED_WORKFLOW_C_MAINTENANCE_SCHEDULER_INSTANCES=1
GEO_RUNTIME_EXPECTED_RECOMMENDATION_ARTIFACT_MAINTENANCE_WORKER_INSTANCES=1
GEO_RUNTIME_EXPECTED_RECOMMENDATION_ARTIFACT_MAINTENANCE_SCHEDULER_INSTANCES=1
GEO_MODEL_GATEWAY_WORKER_SERVICE_IDENTITY_ID=replace-with-provisioned-model-gateway-worker-uuid
GEO_STYLE_COLLECTION_SERVICE_IDENTITY_ID=replace-with-provisioned-style-collection-worker-uuid
GEO_CONNECTOR_SERVICE_IDENTITY_ID=replace-with-provisioned-connector-worker-uuid
GEO_BROWSER_CAPTURE_SERVICE_IDENTITY_ID=replace-with-provisioned-browser-capture-worker-uuid
GEO_BROWSER_RUNTIME_RELEASE=playwright:1.60.0/chromium
GEO_CONNECTOR_ARTIFACT_KEY_REFERENCE=connector-artifact:v1
GEO_BROWSER_ARTIFACT_KEY_REFERENCE=browser-artifact:v1
GEO_CONNECTOR_ARTIFACT_RETENTION_DAYS=90
GEO_BROWSER_ARTIFACT_RETENTION_DAYS=30
# This non-login restore_probe identity and frozen resolve receipt must exist
# before the first production backup. These are metadata, never secret values.
GEO_RESTORE_PROBE_SERVICE_IDENTITY_ID=replace-with-provisioned-restore-probe-uuid
GEO_RESTORE_SECRET_REFERENCE_ID=replace-with-frozen-secret-reference-uuid
GEO_RESTORE_SECRET_PROJECT_ID=replace-with-frozen-secret-project-uuid
GEO_RESTORE_SECRET_PURPOSE=restore_probe.canary
GEO_RESTORE_SECRET_VERSION=1
GEO_RESTORE_SECRET_IDEMPOTENCY_KEY=restore-probe-frozen-resolve-v1
GEO_WORKFLOW_C_ARTIFACT_MAINTENANCE_JOB_LEASE_SECONDS=300
GEO_WORKFLOW_C_ARTIFACT_STAGED_GRACE_SECONDS=900
GEO_WORKFLOW_C_ARTIFACT_MAINTENANCE_SCHEDULE_SECONDS=60
GEO_WORKFLOW_C_ARTIFACT_MAINTENANCE_SEED_BATCH_SIZE=100
GEO_WORKFLOW_C_ARTIFACT_DELETION_LEASE_SECONDS=120
GEO_WORKFLOW_C_ARTIFACT_MAX_DELETIONS_PER_JOB=100
GEO_RECOMMENDATION_ARTIFACT_MAINTENANCE_JOB_LEASE_SECONDS=300
GEO_RECOMMENDATION_ARTIFACT_MAINTENANCE_SCHEDULE_SECONDS=60
GEO_RECOMMENDATION_ARTIFACT_DELETION_LEASE_SECONDS=120
GEO_RECOMMENDATION_ARTIFACT_MAX_DELETIONS_PER_JOB=100
GEO_SYNTHETIC_ARTIFACT_MAINTENANCE_POLL_SECONDS=60
GEO_SYNTHETIC_ARTIFACT_MAINTENANCE_JOB_LEASE_SECONDS=300
GEO_SYNTHETIC_ARTIFACT_EXPIRY_BATCH_SIZE=100
GEO_SYNTHETIC_ARTIFACT_DELETION_LEASE_SECONDS=120
GEO_SYNTHETIC_ARTIFACT_MAX_DELETIONS_PER_JOB=100

GEO_POSTGRES_INSTALLER_PASSWORD_FILE=/run/geo-secrets/postgres-installer-password
GEO_INSTALLER_DATABASE_URL_FILE=/run/geo-secrets/installer-database-url
GEO_DATABASE_URL_FILE=/run/geo-secrets/application-database-url
GEO_WORKER_DATABASE_URL_FILE=/run/geo-secrets/worker-database-url
GEO_AUTH_TOKEN_SECRET_FILE=/run/geo-secrets/auth-token-secret
GEO_MINIO_ROOT_USER_FILE=/run/geo-secrets/minio-root-user
GEO_MINIO_ROOT_PASSWORD_FILE=/run/geo-secrets/minio-root-password
GEO_OBJECT_STORE_ACCESS_KEY_FILE=/run/geo-secrets/object-store-access-key
GEO_OBJECT_STORE_SECRET_KEY_FILE=/run/geo-secrets/object-store-secret-key
GEO_OBJECT_STORE_BACKUP_ACCESS_KEY_FILE=/run/geo-secrets/object-store-backup-access-key
GEO_OBJECT_STORE_BACKUP_SECRET_KEY_FILE=/run/geo-secrets/object-store-backup-secret-key
GEO_OBJECT_STORE_RESTORE_ACCESS_KEY_FILE=/run/geo-secrets/object-store-restore-access-key
GEO_OBJECT_STORE_RESTORE_SECRET_KEY_FILE=/run/geo-secrets/object-store-restore-secret-key
GEO_OBJECT_STORE_RETENTION_ACCESS_KEY_FILE=/run/geo-secrets/object-store-retention-access-key
GEO_OBJECT_STORE_RETENTION_SECRET_KEY_FILE=/run/geo-secrets/object-store-retention-secret-key
GEO_DEEPSEEK_API_KEY_FILE=/run/geo-secrets/deepseek-api-key
GEO_RESTORE_SMOKE_PASSWORD_FILE=/run/geo-secrets/restore-smoke-password
# These seven key domains must use different files and key material.
GEO_SECRET_STORE_MASTER_KEYRING_FILE=/run/geo-secrets/secret-store-master-keyring.json
GEO_SECRET_STORE_REQUEST_HASH_KEY_FILE=/run/geo-secrets/secret-store-request-hash-key
GEO_PROVIDER_ARTIFACT_KEYRING_FILE=/run/geo-secrets/provider-artifact-keyring.json
GEO_SYNTHETIC_ARTIFACT_KEYRING_FILE=/run/geo-secrets/synthetic-artifact-keyring.json
GEO_RECOMMENDATION_ARTIFACT_KEYRING_FILE=/run/geo-secrets/recommendation-artifact-keyring.json
GEO_RECOMMENDATION_ARTIFACT_OBJECT_STORE_ACCESS_KEY_FILE=/run/geo-secrets/recommendation-artifact-object-store-access-key
GEO_RECOMMENDATION_ARTIFACT_OBJECT_STORE_SECRET_KEY_FILE=/run/geo-secrets/recommendation-artifact-object-store-secret-key
GEO_RECOMMENDATION_ARTIFACT_DELETER_ACCESS_KEY_FILE=/run/geo-secrets/recommendation-artifact-deleter-access-key
GEO_RECOMMENDATION_ARTIFACT_DELETER_SECRET_KEY_FILE=/run/geo-secrets/recommendation-artifact-deleter-secret-key
GEO_WORKFLOW_C_ARTIFACT_KEYRING_FILE=/run/geo-secrets/workflow-c-artifact-keyring.json
GEO_WORKFLOW_C_ARTIFACT_OBJECT_STORE_ACCESS_KEY_FILE=/run/geo-secrets/workflow-c-artifact-object-store-access-key
GEO_WORKFLOW_C_ARTIFACT_OBJECT_STORE_SECRET_KEY_FILE=/run/geo-secrets/workflow-c-artifact-object-store-secret-key
GEO_WORKFLOW_C_ARTIFACT_READER_ACCESS_KEY_FILE=/run/geo-secrets/workflow-c-artifact-reader-access-key
GEO_WORKFLOW_C_ARTIFACT_READER_SECRET_KEY_FILE=/run/geo-secrets/workflow-c-artifact-reader-secret-key
GEO_WORKFLOW_C_ARTIFACT_DELETER_ACCESS_KEY_FILE=/run/geo-secrets/workflow-c-artifact-deleter-access-key
GEO_WORKFLOW_C_ARTIFACT_DELETER_SECRET_KEY_FILE=/run/geo-secrets/workflow-c-artifact-deleter-secret-key
GEO_SYNTHETIC_STYLE_ARTIFACT_WRITER_ACCESS_KEY_FILE=/run/geo-secrets/synthetic-style-artifact-writer-access-key
GEO_SYNTHETIC_STYLE_ARTIFACT_WRITER_SECRET_KEY_FILE=/run/geo-secrets/synthetic-style-artifact-writer-secret-key
GEO_SYNTHETIC_ARTIFACT_DELETER_ACCESS_KEY_FILE=/run/geo-secrets/synthetic-artifact-deleter-access-key
GEO_SYNTHETIC_ARTIFACT_DELETER_SECRET_KEY_FILE=/run/geo-secrets/synthetic-artifact-deleter-secret-key
GEO_ALERT_SMTP_USERNAME_FILE=/run/geo-secrets/alert-smtp-username
GEO_ALERT_SMTP_PASSWORD_FILE=/run/geo-secrets/alert-smtp-password
GEO_ALERT_WEBHOOK_SIGNING_SECRET_FILE=/run/geo-secrets/alert-webhook-signing-secret
GEO_BACKUP_KEYRING_FILE=/run/geo-backup-secrets/backup-keyring.json
GEO_BACKUP_ROOT=/srv/geo-backups
GEO_BACKUP_MINIO_STAGING_SIZE=8g
# Pre-create this as a dedicated 0700 tmpfs mount; restore fails closed on disk-backed paths.
GEO_RESTORE_TMPFS_ROOT=/run/geo-restore-tmpfs

# Alert delivery. Hosts are exact DNS names, never wildcards or URLs.
GEO_ALERT_SMTP_UPSTREAM_HOST=smtp.example.com
GEO_ALERT_SMTP_UPSTREAM_ALLOWED_HOSTS=smtp.example.com
GEO_ALERT_SMTP_UPSTREAM_PORT=587
GEO_ALERT_SMTP_TLS_MODE=starttls
GEO_ALERT_SMTP_SENDER=geo-alerts@example.com
GEO_ALERT_SMTP_RECIPIENTS=geo-ops@example.com
GEO_ALERT_WEBHOOK_ENDPOINT=https://alerts.intranet.example/hooks/geo
GEO_ALERT_WEBHOOK_ALLOWED_HOSTS=alerts.intranet.example

# Isolated Style Browser. The allowlist contains exact DNS hostnames, never wildcards or URLs.
GEO_STYLE_BROWSER_WORKER_DATABASE_URL_FILE=/run/geo-secrets/style-browser-worker-database-url
GEO_CONNECTOR_WORKER_DATABASE_URL_FILE=/run/geo-secrets/connector-worker-database-url
GEO_BROWSER_CAPTURE_WORKER_DATABASE_URL_FILE=/run/geo-secrets/browser-capture-worker-database-url
GEO_CONNECTOR_ARTIFACT_KEY_FILE=/run/geo-secrets/connector-artifact-key
GEO_CONNECTOR_ARTIFACT_WRITER_ACCESS_KEY_FILE=/run/geo-secrets/connector-artifact-writer-access-key
GEO_CONNECTOR_ARTIFACT_WRITER_SECRET_KEY_FILE=/run/geo-secrets/connector-artifact-writer-secret-key
GEO_BROWSER_ARTIFACT_KEY_FILE=/run/geo-secrets/browser-artifact-key
GEO_BROWSER_ARTIFACT_WRITER_ACCESS_KEY_FILE=/run/geo-secrets/browser-artifact-writer-access-key
GEO_BROWSER_ARTIFACT_WRITER_SECRET_KEY_FILE=/run/geo-secrets/browser-artifact-writer-secret-key
GEO_STYLE_COLLECTION_COMPOSITION_FACTORY=geo_style_worker.composition:build_style_collection_dispatcher
GEO_STYLE_ADAPTER_REGISTRY_FILE=/etc/geo/style-adapter-registry.v1.json
GEO_STYLE_ADAPTER_REGISTRY_SHA256=1d0ff9f03e318de2eca58e7c9657f5a86940a128cd5726b2c2896e05a0fc72ac
GEO_STYLE_ROBOTS_TIMEOUT_SECONDS=10
GEO_STYLE_ALLOWED_EGRESS_HOSTS=approved.example,robots-approved.example,www.amazon.com.au,m.media-amazon.com,images-na.ssl-images-amazon.com,www.youtube.com,i.ytimg.com,yt3.ggpht.com,www.tiktok.com,sf16-website-login.neutral.ttwstatic.com,p16-sign-va.tiktokcdn.com,www.instagram.com,static.cdninstagram.com,www.productreview.com.au,cdn.productreview.com.au,www.reddit.com,www.redditstatic.com,styles.redditmedia.com,www.ozbargain.com.au,files.ozbargain.com.au,www.quora.com,qsf.cf2.quoracdn.net
GEO_STYLE_CHROMIUM_EXECUTABLE=/ms-playwright/chromium-<reviewed-release>/chrome-linux/headless_shell

GEO_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
GEO_JWT_ISSUER=https://identity.example.com/
GEO_JWT_AUDIENCE=geo-admin
GEO_AUTH_MODE=oidc
GEO_OIDC_TENANT_CLAIM=tenant_id
GEO_ADMIN_OIDC_LOGIN_URL=https://auth-gateway.example.com/oauth2/start
GEO_ADMIN_OIDC_LOGOUT_URL=https://auth-gateway.example.com/oauth2/sign_out
GEO_ADMIN_OIDC_ALLOWED_ORIGINS=https://auth-gateway.example.com
GEO_CUSTOMER_SESSION_COOKIE_NAME=GEO_CUSTOMER_SESSION
GEO_ADMIN_WEB_BASE_URL=https://admin.example.com
GEO_CUSTOMER_WEB_BASE_URL=https://portal.example.com

# Replace every bootstrap value before the one-time provisioning command.
GEO_BOOTSTRAP_TENANT_ID=replace-with-tenant-uuid
GEO_BOOTSTRAP_TENANT_NAME=Replace with customer organisation
GEO_BOOTSTRAP_OIDC_ISSUER=https://identity.example.com/
GEO_BOOTSTRAP_OIDC_SUBJECT=replace-with-oidc-subject
GEO_BOOTSTRAP_EMAIL=replace-owner@example.invalid
GEO_BOOTSTRAP_DISPLAY_NAME=Replace with initial owner
GEO_BOOTSTRAP_PROJECT_ID=replace-with-project-uuid
GEO_BOOTSTRAP_PROJECT_NAME=Replace with initial project
