# Canonical internal GEO + Dify operator deployment.
# Copy this file to infra/geo-stack.env and replace every absolute path.
GEO_STACK_PROJECT=geo
GEO_RELEASE_COMMIT=replace-with-40-character-commit
GEO_POSTGRES_HOST_PORT=55433
GEO_MINIO_HOST_PORT=19000
GEO_MINIO_CONSOLE_HOST_PORT=19001
GEO_VALKEY_HOST_PORT=16379
GEO_INTERNAL_API_HOST_PORT=18000
GEO_CUSTOMER_API_HOST_PORT=18001
GEO_ADMIN_WEB_HOST_PORT=13001
GEO_CUSTOMER_WEB_HOST_PORT=13000
GEO_DEV_TOOLS_ENABLED=0
GEO_ADMIN_ACTOR_ID=replace-with-owner-identity-uuid
GEO_ADMIN_TENANT_ID=replace-with-tenant-uuid
GEO_MODEL_GATEWAY_WORKER_SERVICE_IDENTITY_ID=replace-with-worker-identity-uuid
GEO_CONNECTOR_SERVICE_IDENTITY_ID=40000000-0000-4000-8000-000000000004
GEO_BROWSER_CAPTURE_SERVICE_IDENTITY_ID=40000000-0000-4000-8000-000000000005
GEO_DIFY_BIND_HOST=127.0.0.1
GEO_DIFY_HOST_PORT=15000
GEO_DIFY_CONSOLE_URL=http://127.0.0.1:15000
GEO_DIFY_STATE_HOST_FILE=/absolute/path/to/.runtime/geo-dify-state.json
GEO_DEEPSEEK_API_KEY_FILE=/absolute/path/to/deepseek_api_key.txt
GEO_SECRET_STORE_MASTER_KEYRING_FILE=/absolute/path/to/secret-store-keyring.json
GEO_SECRET_STORE_REQUEST_HASH_KEY_FILE=/absolute/path/to/secret-request-hash-key
GEO_CONNECTOR_ARTIFACT_KEY_FILE=/absolute/path/to/connector-artifact-key
GEO_BROWSER_ARTIFACT_KEY_FILE=/absolute/path/to/browser-artifact-key
GEO_STAGING_SECRET_STORE_MASTER_KEYRING_FILE=/absolute/path/to/secret-store-keyring.json
GEO_STAGING_SECRET_STORE_REQUEST_HASH_KEY_FILE=/absolute/path/to/secret-request-hash-key
GEO_STAGING_PROVIDER_ARTIFACT_KEYRING_FILE=/absolute/path/to/provider-artifact-keyring.json
GEO_STAGING_SYNTHETIC_ARTIFACT_KEYRING_FILE=/absolute/path/to/synthetic-artifact-keyring.json
GEO_STAGING_RECOMMENDATION_ARTIFACT_KEYRING_FILE=/absolute/path/to/recommendation-artifact-keyring.json
GEO_STAGING_RECOMMENDATION_ARTIFACT_OBJECT_STORE_ACCESS_KEY_FILE=/absolute/path/to/recommendation-artifact-object-store-access-key
GEO_STAGING_RECOMMENDATION_ARTIFACT_OBJECT_STORE_SECRET_KEY_FILE=/absolute/path/to/recommendation-artifact-object-store-secret-key
GEO_STAGING_WORKFLOW_C_ARTIFACT_KEYRING_FILE=/absolute/path/to/workflow-c-artifact-keyring.json
GEO_STAGING_WORKFLOW_C_ARTIFACT_READER_ACCESS_KEY_FILE=/absolute/path/to/workflow-c-reader-access-key
GEO_STAGING_WORKFLOW_C_ARTIFACT_READER_SECRET_KEY_FILE=/absolute/path/to/workflow-c-reader-secret-key
GEO_STAGING_ALERT_WEBHOOK_SIGNING_SECRET_FILE=/absolute/path/to/alert-webhook-signing-secret
GEO_STAGING_ALERT_WEBHOOK_CA_FILE=/absolute/path/to/alert-webhook-ca.pem
GEO_STAGING_ALERT_WEBHOOK_TLS_KEY_FILE=/absolute/path/to/alert-webhook-tls-key.pem

# Encrypted migration transport.  The passphrase file is never committed.
GEO_SYNC_ARCHIVE_REPO=owner/private-geo-repository
GEO_SYNC_PASSPHRASE_FILE=/absolute/path/to/geo-migration-passphrase
GEO_SYNC_OUTPUT_ROOT=/srv/geo-migrations
