# Paths point to mode 0600 files provisioned outside the repository.
GEO_MINIO_ROOT_USER_SECRET_FILE=/run/geo-secrets/minio-root-user
GEO_MINIO_ROOT_PASSWORD_SECRET_FILE=/run/geo-secrets/minio-root-password
GEO_OBJECT_STORE_APPLICATION_ACCESS_KEY_SECRET_FILE=/run/geo-secrets/object-store-application-access-key
GEO_OBJECT_STORE_APPLICATION_SECRET_KEY_SECRET_FILE=/run/geo-secrets/object-store-application-secret-key
GEO_OBJECT_STORE_BACKUP_ACCESS_KEY_SECRET_FILE=/run/geo-secrets/object-store-backup-access-key
GEO_OBJECT_STORE_BACKUP_SECRET_KEY_SECRET_FILE=/run/geo-secrets/object-store-backup-secret-key
GEO_OBJECT_STORE_RESTORE_ACCESS_KEY_SECRET_FILE=/run/geo-secrets/object-store-restore-access-key
GEO_OBJECT_STORE_RESTORE_SECRET_KEY_SECRET_FILE=/run/geo-secrets/object-store-restore-secret-key
GEO_OBJECT_STORE_RETENTION_ACCESS_KEY_SECRET_FILE=/run/geo-secrets/object-store-retention-access-key
GEO_OBJECT_STORE_RETENTION_SECRET_KEY_SECRET_FILE=/run/geo-secrets/object-store-retention-secret-key

# The named volume must be created by the platform on encrypted storage first.
GEO_MINIO_ENCRYPTED_VOLUME_NAME=geo-production-minio-encrypted

# Bind smoke and ephemeral principals to one approved run.
OBJECT_STORE_BACKUP_PREFIX=production/prod/
OBJECT_STORE_BACKUP_SMOKE_PREFIX=smoke/replace-with-run-id/
OBJECT_STORE_RESTORE_PREFIX=restore-smoke/replace-with-run-id/
OBJECT_STORE_RETENTION_PREFIX=retention-approved/replace-with-manifest-id/
MINIO_BOOTSTRAP_ENABLE_EPHEMERAL=0

# Existing production overlay requirements.
GEO_CONNECTOR_SECRET_MASTER_KEY=replace-via-secret-manager
GEO_REPORT_ARTIFACT_SIGNING_SECRET=replace-via-secret-manager
