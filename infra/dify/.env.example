# Bind to loopback for a local-only console. Use 0.0.0.0 on a private staging
# host when operators must open Dify from the same network as the Admin site.
GEO_DIFY_BIND_HOST=127.0.0.1
GEO_DIFY_HOST_PORT=15000

# Used by the GEO internal API to build the direct workflow link. The Admin
# page also repairs old localhost links to the host currently serving Admin.
GEO_DIFY_CONSOLE_URL=http://127.0.0.1:15000

# Worker timeout for blocking Workflow API calls.
GEO_DIFY_TIMEOUT_SECONDS=180
