+++ b/web/app/components/workflow/panel/geo-run-input-picker.tsx
@@ -0,0 +1,204 @@
+import type { ReactNode } from 'react'
+import type { InputVar } from '../types'
+import type { WorkflowRunDetailResponse } from '@/models/log'
+import type { WorkflowRunHistory } from '@/types/workflow'
+import { Button } from '@langgenius/dify-ui/button'
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectItemIndicator,
+  SelectItemText,
+  SelectTrigger,
+} from '@langgenius/dify-ui/select'
+import { useQueries } from '@tanstack/react-query'
+import dayjs from 'dayjs'
+import { useEffect, useMemo, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { fetchRunDetail } from '@/service/log'
+import { useWorkflowRunHistory } from '@/service/use-workflow'
+import { useWorkflowStore } from '../store'
+
+const GEO_INPUT_KEYS = [
+  'geo_context_json',
+  'geo_context_hash',
+  'geo_input_hash',
+  'geo_output_schema_json',
+  'geo_purpose',
+] as const
+
+type GeoInputKey = (typeof GEO_INPUT_KEYS)[number]
+type GeoInputs = Record<GeoInputKey, string>
+
+type GeoBusinessRun = {
+  id: string
+  createdAt: number
+  jobId: string
+  inputs: GeoInputs
+}
+
+type Props = Readonly<{
+  appId?: string
+  variables: InputVar[]
+  children: ReactNode
+}>
+
+const MAX_HISTORY_SCAN = 100
+const MAX_BUSINESS_RUNS = 20
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value)
+
+const parseInputs = (value: unknown): Record<string, unknown> | undefined => {
+  if (isRecord(value)) return value
+  if (typeof value !== 'string') return undefined
+
+  try {
+    const parsed: unknown = JSON.parse(value)
+    return isRecord(parsed) ? parsed : undefined
+  } catch {
+    return undefined
+  }
+}
+
+const extractGeoInputs = (value: unknown): GeoInputs | undefined => {
+  const parsed = parseInputs(value)
+  if (!parsed) return undefined
+  if (!GEO_INPUT_KEYS.every((key) => typeof parsed[key] === 'string')) return undefined
+
+  return Object.fromEntries(GEO_INPUT_KEYS.map((key) => [key, parsed[key]])) as GeoInputs
+}
+
+const isGeoManagedWorkflow = (variables: InputVar[]) => {
+  const variableNames = new Set(variables.map((variable) => variable.variable))
+  return GEO_INPUT_KEYS.every((key) => variableNames.has(key))
+}
+
+const getBusinessRun = (
+  history: WorkflowRunHistory,
+  detail?: WorkflowRunDetailResponse,
+): GeoBusinessRun | undefined => {
+  const sessionId = detail?.created_by_end_user?.session_id
+  const inputs = extractGeoInputs(detail?.inputs)
+  if (!detail || detail.status !== 'succeeded' || !sessionId?.startsWith('geo-job:') || !inputs)
+    return undefined
+
+  return {
+    id: history.id,
+    createdAt: detail.created_at || history.created_at,
+    jobId: sessionId.slice('geo-job:'.length),
+    inputs,
+  }
+}
+
+const formatRunLabel = (run: GeoBusinessRun) => {
+  const shortJobId = run.jobId.length > 12 ? `${run.jobId.slice(0, 12)}...` : run.jobId
+  return `${dayjs.unix(run.createdAt).format('YYYY-MM-DD HH:mm')} · ${run.inputs.geo_purpose} · ${shortJobId}`
+}
+
+export const GeoRunInputPicker = ({ appId, variables, children }: Props) => {
+  const { t } = useTranslation()
+  const workflowStore = useWorkflowStore()
+  const managed = isGeoManagedWorkflow(variables)
+  const [selectedRunId, setSelectedRunId] = useState('')
+  const [manualEditing, setManualEditing] = useState(false)
+  const initializedAppIdRef = useRef<string | undefined>(undefined)
+  const historyUrl = appId
+    ? `/apps/${appId}/workflow-runs?triggered_from=app-run&status=succeeded&limit=${MAX_HISTORY_SCAN}`
+    : undefined
+  const historyQuery = useWorkflowRunHistory(historyUrl, managed && !!appId)
+  const histories = useMemo(() => historyQuery.data?.data ?? [], [historyQuery.data?.data])
+  const { details, detailsFailed, detailsLoading } = useQueries({
+    queries: histories.map((history) => ({
+      enabled: managed && !!appId,
+      queryKey: ['geo-run-input', appId, history.id],
+      queryFn: () => fetchRunDetail(`/apps/${appId}/workflow-runs/${history.id}`),
+      staleTime: 30_000,
+    })),
+    combine: (results) => ({
+      details: results.map((result) => result.data),
+      detailsFailed: results.some((result) => result.isError),
+      detailsLoading: results.some((result) => result.isLoading),
+    }),
+  })
+  const businessRuns = useMemo(
+    () =>
+      histories
+        .map((history, index) => getBusinessRun(history, details[index]))
+        .filter((run): run is GeoBusinessRun => !!run)
+        .sort((left, right) => right.createdAt - left.createdAt)
+        .slice(0, MAX_BUSINESS_RUNS),
+    [details, histories],
+  )
+  const loading = historyQuery.isLoading || detailsLoading
+  const failed = historyQuery.isError || detailsFailed
+  const selectedRun = businessRuns.find((run) => run.id === selectedRunId) ?? businessRuns[0]
+  const editing = manualEditing || (!loading && !selectedRun)
+
+  useEffect(() => {
+    if (!managed || !appId || loading || failed || initializedAppIdRef.current === appId) return
+    initializedAppIdRef.current = appId
+    const newest = businessRuns[0]
+    if (!newest) return
+    workflowStore.getState().setInputs(newest.inputs)
+  }, [appId, businessRuns, failed, loading, managed, workflowStore])
+
+  if (!managed) return children
+
+  const handleRunChange = (runId: string | null) => {
+    if (!runId) return
+    const run = businessRuns.find((candidate) => candidate.id === runId)
+    if (!run) return
+    workflowStore.getState().setInputs(run.inputs)
+    setSelectedRunId(run.id)
+    setManualEditing(false)
+  }
+
+  return (
+    <>
+      <div className="border-b border-divider-subtle px-4 py-3">
+        <div className="mb-2 flex items-center justify-between gap-2">
+          <div className="text-xs font-medium text-text-secondary">
+            {t(($) => $['common.runHistory'], { ns: 'workflow' })}
+          </div>
+          {!!selectedRun && (
+            <Button
+              size="small"
+              variant="ghost"
+              onClick={() => setManualEditing((value) => !value)}
+            >
+              {editing
+                ? t(($) => $['operation.ok'], { ns: 'common' })
+                : t(($) => $['operation.edit'], { ns: 'common' })}
+            </Button>
+          )}
+        </div>
+        {loading && (
+          <div className="text-xs text-text-tertiary">{t(($) => $.loading, { ns: 'common' })}</div>
+        )}
+        {!loading && failed && (
+          <div className="text-xs text-text-warning">{t(($) => $.error, { ns: 'common' })}</div>
+        )}
+        {!loading && !failed && businessRuns.length === 0 && (
+          <div className="text-xs text-text-tertiary">{t(($) => $.noData, { ns: 'common' })}</div>
+        )}
+        {!loading && businessRuns.length > 0 && (
+          <Select value={selectedRun?.id ?? ''} onValueChange={handleRunChange}>
+            <SelectTrigger className="h-8 w-full" aria-label="GEO run history">
+              {selectedRun ? formatRunLabel(selectedRun) : t(($) => $.noData, { ns: 'common' })}
+            </SelectTrigger>
+            <SelectContent listClassName="max-h-[240px] overflow-y-auto">
+              {businessRuns.map((run) => (
+                <SelectItem key={run.id} value={run.id}>
+                  <SelectItemText>{formatRunLabel(run)}</SelectItemText>
+                  <SelectItemIndicator />
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+        )}
+      </div>
+      {(editing || !selectedRun) && children}
+    </>
+  )
+}
